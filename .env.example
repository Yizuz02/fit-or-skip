# OpenAI-compatible LLM provider settings.
# Swap these three to change providers (e.g. Ollama local -> OpenRouter) with no code changes.
LLM_BASE_URL="http://localhost:11434/v1/"
LLM_API_KEY="ollama"
LLM_MODEL="gemma4:e2b"

# Set LLM_STUB=1 to return a canned response without calling any model.
LLM_STUB=0
# Set LLM_ENABLED=false to disable model output entirely (endpoint returns 503).
LLM_ENABLED=true
